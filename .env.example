# Public A-Guy-Web origin. A-Guy-Dash forwards the shared HttpOnly cookie only
# to this service for session verification, admin authorization, and logout.
AGUY_WEB_URL=https://www.aguy.co.il

# Stable API-only origin. Authentication and data are still owned by
# A-Guy-Web; this hostname is an independent public boundary, not a new backend.
AGUY_API_URL=https://api.aguy.co.il

# Canonical HTTPS origin used as the central login return destination and for
# same-origin protection on the logout proxy.
DASHBOARD_PUBLIC_URL=https://dash.aguy.co.il

# Local shared-login development example:
# AGUY_WEB_URL=http://app.lvh.me:3000
# AGUY_API_URL=http://app.lvh.me:3000
# DASHBOARD_PUBLIC_URL=http://dash.lvh.me:3001
