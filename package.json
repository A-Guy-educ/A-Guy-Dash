{
  "name": "a-guy-dash",
  "version": "0.3.0",
  "private": true,
  "description": "A-Guy administrative analytics dashboard",
  "license": "BSL-1.1",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vitest.config.ts",
    "format": "prettier --write src package.json tsconfig.json next.config.js tailwind.config.mjs vitest.config.ts README.md",
    "format:check": "prettier --check src package.json tsconfig.json next.config.js tailwind.config.mjs vitest.config.ts README.md",
    "test": "vitest run"
  },
  "dependencies": {
    "@a-guy/api-client": "https://github.com/A-Guy-educ/A-Guy-Shared/releases/download/v0.1.1/a-guy-api-client-0.1.1.tgz",
    "@a-guy/ui": "https://github.com/A-Guy-educ/A-Guy-Shared/releases/download/v0.1.1/a-guy-ui-0.1.1.tgz",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "next": "15.5.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^26.4.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.5.9",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.2.2",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^10 || ^11"
  },
  "packageManager": "pnpm@10.33.0"
}
